# Tier 2（云端）凭据模板。
#
# 复制为 .env 并填入自己的值：cp .env.example .env
# .gitignore 已排除 .env（规则 `*.env`），并显式白名单本文件（`!*.env.example`）。
#
# **不配这些也能跑本地三层流水线**——Tier 0 / 0.5 / 1 全在本地，无需联网。
# 只有 ④ 四臂对照评测（skills/evals/run_comparison.py --arm X）必须用它。
# 未配置时 route.enforce_safety_boundary 会把 Tier 2 压回本地
# （结果里 cloud_authorized=False、tier2_used=false），不是报错。

# StepFun API 凭据
STEPFUN_API_KEY=

# API 端点。国内站 https://api.stepfun.com/v1 ；国际站 https://api.stepfun.ai/v1
# 注意：站点与 Key 必须匹配，否则 401（国内 Key 配 .ai 端点是最常见的错法）
STEPFUN_BASE_URL=https://api.stepfun.com/v1

# 主力模型名
STEPFUN_MODEL=step-5-preview
